{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "DeepSwift", "target-membership": [ "DeepSwift" ] },
    { "kind": "folder", "path": "DeepSwiftTests", "target-membership": [ "DeepSwiftTests" ] },
    { "kind": "folder", "path": "DeepSwiftUITests", "target-membership": [ "DeepSwiftUITests" ] },
    { "kind": "folder", "path": "SwiftTerm", "target-membership": [ "SwiftTerm" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/DeepSwift.app", "id": "6E174B863099C56000ABCB8E", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/DeepSwiftTests.xctest", "id": "6E174B933099C56200ABCB8E", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/DeepSwiftUITests.xctest", "id": "6E174B9D3099C56200ABCB8E", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/SwiftTerm.framework", "id": "6E174C40309A052F00ABCB8E", "type": "wrapper.framework", "index": false, "target-membership": [ "DeepSwift/copy/Embed Frameworks" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "DeepSwift",
      "id": "6E174B853099C56000ABCB8E",
      "product": "Products/DeepSwift.app",
      "product-type": "application",
      "dependencies": [
        "SwiftTerm",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(FRAMEWORKS_FOLDER_PATH)",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "YM5G2M8PV9",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "DeepSwift",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "15.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "com.lloydME.DeepSwift.Beta",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "com.lloydME.DeepSwift",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "DeepSwiftTests",
      "id": "6E174B923099C56200ABCB8E",
      "product": "Products/DeepSwiftTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "DeepSwift",
      "dependencies": [
        "DeepSwift",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "YM5G2M8PV9",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "27.2",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.lloydME.DeepSwiftTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/DeepSwift.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/DeepSwift",
      },
    }, {
      "name": "DeepSwiftUITests",
      "id": "6E174B9C3099C56200ABCB8E",
      "product": "Products/DeepSwiftUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "DeepSwift",
      "dependencies": [
        "DeepSwift",
      ],
